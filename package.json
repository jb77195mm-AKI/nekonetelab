{
  "name": "hp-sample-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:sites": "vinext build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ignore-pattern dist --ignore-pattern .vinext --ignore-pattern .wrangler",
    "test": "npm run typecheck && npm run lint && npm run test:locales && npm run test:business-model",
    "test:locales": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-queue-locales.mjs",
    "test:business-model": "node scripts/check-business-model.mjs",
    "check": "npm run test && npm run build",
    "audit:prod": "npm audit --omit=dev",
    "smoke": "node scripts/smoke-test.mjs",
    "create-site": "node scripts/create-site.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitejs/plugin-rsc": "^0.5.26",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vinext": "^0.0.50",
    "vite": "^8.0.13",
    "wrangler": "^4.92.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "type": "module"
}
