{
  "name": "hp-sample-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "npm run typecheck && npm run lint && npm run test:locales",
    "test:locales": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-queue-locales.mjs",
    "check": "npm run test && npm run build",
    "audit:prod": "npm audit --omit=dev",
    "smoke": "node scripts/smoke-test.mjs",
    "create-site": "node scripts/create-site.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
