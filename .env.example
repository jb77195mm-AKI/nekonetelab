# 正規URL。Productionでは公式URL、デモではデモURLまたは空欄にします。
NEXT_PUBLIC_SITE_URL=

# デモは true、公式本番は false。未指定時は正規URLが公式URLかどうかで判定します。
NEXT_PUBLIC_DEMO_MODE=true

# 公開前は true。本番移行時も最終確認が終わるまで false にしません。
NEXT_PUBLIC_NOINDEX=true

# 任意: Google Analytics 4の測定ID（G-から始まる値）。
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# 任意: Google Search ConsoleのHTMLタグ方式で発行された確認トークン。
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# 問い合わせの転送先。Formspree等、利用する外部サービス側でも同じ受信先を設定してください。
CONTACT_TO_EMAIL=info@nekonotedejitarurabo.com

# デモでは必ず mock。forward は本番移行時にだけ検討します。
CONTACT_DELIVERY_MODE=mock

# 問い合わせフォームの転送エンドポイント。mock時は使用しません。
CONTACT_FORM_ENDPOINT=

# 公式LINE。通常はこの確定済みURLを使用し、変更時のみ上書きします。
LINE_OFFICIAL_URL=https://lin.ee/rWvSMpg

# 公開する事業者情報。未指定時もコード内の確定値を使用します。
BUSINESS_PHONE=070-8933-4067
BUSINESS_ADDRESS=三重県名張市赤目町丈六23-5
BUSINESS_HOURS=平日9時～18時
BUSINESS_SERVICE_AREA=名張市・伊賀市周辺／全国オンライン

# Stripeは mock または stripe_test のみ。本番モードは実装していません。
SUBSCRIPTION_CHECKOUT_MODE=mock
STRIPE_SECRET_KEY=sk_test_xxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx
STRIPE_PRICE_ID_WEB_START=price_xxxxxxxxx
NEXT_PUBLIC_STRIPE_CUSTOMER_PORTAL_URL=https://billing.stripe.com/p/login/xxxxxxxx
