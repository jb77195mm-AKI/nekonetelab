# 本番公開URL。HTTPS必須、末尾の / は不要です。未確定の間は空欄にします。
NEXT_PUBLIC_SITE_URL=

# 公開前は true。本番URL・フォーム・表示内容を確認後に false へ変更します。
NEXT_PUBLIC_NOINDEX=true

# 任意: Google Analytics 4の測定ID（G-から始まる値）。
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# 任意: Google Search ConsoleのHTMLタグ方式で発行された確認トークン。
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# 問い合わせの転送先。Formspree等、利用する外部サービス側でも同じ受信先を設定してください。
CONTACT_TO_EMAIL=info@nekonotedejitarurabo.com

# 問い合わせフォームの転送エンドポイント。未設定時は送信せず、メール連絡をご案内します。
CONTACT_FORM_ENDPOINT=

# 公式LINE。通常はこの確定済みURLを使用し、変更時のみ上書きします。
LINE_OFFICIAL_URL=https://lin.ee/rWvSMpg

# 未確定の任意項目。空欄の項目は本番画面に表示されません。
BUSINESS_PHONE=
BUSINESS_ADDRESS=
BUSINESS_HOURS=
BUSINESS_SERVICE_AREA=
